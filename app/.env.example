# PollPop — env template
# Copy to .env.local and fill values. App runs WITHOUT these (mock mode).

# Supabase (provision via https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only salt for ip_hash (any random string, e.g. openssl rand -hex 16)
IP_HASH_SALT=local-dev-salt-change-me

# Optional
OG_CACHE_TTL=3600
NEXT_PUBLIC_APP_URL=http://localhost:3000
